{
  "name": "@mapward/cli",
  "version": "0.1.0",
  "description": "Command-line mapward: reads a map from disk, runs metrics, actions and plugin checks, serves MCP, installs from the marketplace.",
  "keywords": [
    "agents",
    "architecture",
    "map",
    "mapward",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapward-org/mapward.git",
    "directory": "apps/cli"
  },
  "bin": {
    "mapward": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "esbuild-wasm": "catalog:",
    "rxjs": "catalog:",
    "tailwindcss": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@mapward/abstract-server": "workspace:*",
    "@mapward/core": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:"
  }
}
