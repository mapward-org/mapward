{
  "name": "@mapward/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line binding: reads a map from disk and runs checks in CI or a terminal.",
  "bin": {
    "mapward": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@mapward/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:"
  }
}
