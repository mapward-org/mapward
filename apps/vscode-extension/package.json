{
  "name": "@archmap/vscode-extension",
  "version": "0.0.0",
  "private": true,
  "description": "VSCode binding: hosts the UI in a webview and gives the packages an editor environment.",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/extension.cjs",
  "types": "./dist/extension.d.cts",
  "exports": {
    ".": {
      "types": "./dist/extension.d.cts",
      "default": "./dist/extension.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@archmap/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:"
  }
}
