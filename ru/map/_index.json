{
  "name": "Mapward (ru)",
  "extends": "mapward://prototypes/base",
  "metric-groups": {
    "groups": [
      {
        "key": "продукт",
        "label": "Работа с продуктом",
        "description": "Что делаем и почему: идеи, требования, решения и проверки к ним.",
        "metrics": [
          "product-docs",
          "requirements-todo",
          "requirements",
          "decisions",
          "decisions-drift",
          "requirements-links",
          "children-list"
        ],
        "details-metrics-layout": {
          "areas": [
            ["product-docs"],
            ["requirements-todo"],
            ["requirements"],
            ["decisions"],
            ["decisions-drift"],
            ["requirements-links"],
            ["children-list"]
          ],
          "style": {
            "gap": "8px"
          }
        }
      },
      {
        "key": "архитектура",
        "label": "Архитектура",
        "description": "Как устроен монореп: доки, связи между пакетами и их качество.",
        "metrics": ["architecture-docs", "package-deps", "architecture-quality", "children"],
        "details-metrics-layout": {
          "areas": [
            ["architecture-docs"],
            ["package-deps"],
            ["architecture-quality"],
            ["children"]
          ],
          "style": {
            "gridTemplateRows": "auto auto auto minmax(320px, auto)",
            "gap": "8px"
          }
        }
      },
      {
        "key": "агенту",
        "label": "Агенту",
        "description": "То, что агенты спрашивают каждый прогон, — посчитанным. Витрина: агент берёт эти метрики по ключу и без вкладки.",
        "metrics": ["agent-requirements", "agent-decisions", "agent-build", "agent-worktree"],
        "details-metrics-layout": {
          "areas": [
            ["agent-requirements"],
            ["agent-decisions"],
            ["agent-build"],
            ["agent-worktree"]
          ],
          "style": {
            "gap": "8px"
          }
        }
      },
      {
        "key": "дисплеи",
        "label": "Тестовые дисплеи",
        "description": "Метрики, нарисованные своими React-компонентами (решение 0037): образцы, на которых проверяется дисплей `component`.",
        "metrics": ["demo-directives", "demo-decisions", "demo-kit"],
        "details-metrics-layout": {
          "areas": [["demo-directives"], ["demo-decisions"], ["demo-kit"]],
          "style": {
            "gap": "8px"
          }
        }
      },
      {
        "key": "карта",
        "label": "Про карту",
        "description": "Из чего собрана карта и как ею пользуются.",
        "metrics": ["prototypes", "shared-metrics", "guide", "directive-runs"],
        "details-metrics-layout": {
          "areas": [["prototypes"], ["shared-metrics"], ["guide"], ["directive-runs"]],
          "style": {
            "gap": "8px"
          }
        }
      }
    ]
  }
}
