{
  "label": "Файлы",
  "component": "${{ mapward:// }}/_plugins/views/tree.tsx",
  "params": {
    "source": {
      "plugin": "${{ mapward:// }}/_plugins/shell",
      "method": "json",
      "params": {
        "command": "node \"${{ mapward:// }}/shared-metrics/files/file-actions.mjs\"",
        "from": {
          "plugin": "${{ mapward:// }}/_plugins/files",
          "method": "tree",
          "params": {
            "path": "${{ mapward://~#props.fullPath }}",
            "exclude": ["**/node_modules/**", "**/dist/**"],
            "git": true
          }
        }
      }
    }
  },
  "agent": {
    "plugin": "${{ mapward:// }}/_plugins/shell",
    "method": "json",
    "params": {
      "command": "node \"${{ mapward:// }}/shared-metrics/files/file-actions.mjs\"",
      "from": {
        "plugin": "${{ mapward:// }}/_plugins/files",
        "method": "tree",
        "params": {
          "path": "${{ mapward://~#props.fullPath }}",
          "exclude": ["**/node_modules/**", "**/dist/**"],
          "git": true
        }
      }
    }
  }
}
