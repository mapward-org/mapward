{
  "label": "Файлы",
  "refresh": "on-display",
  "collectors": [
    {
      "kind": "read-dir",
      "basePath": "${{ mapward://~#props.fullPath }}",
      "exclude": ["**/node_modules/**", "**/dist/**"],
      "watch": true
    }
  ],
  "transforms": [
    { "kind": "script", "run": "node \"${{ mapward:// }}/shared-metrics/files/file-actions.mjs\"" },
    { "kind": "git-status" }
  ],
  "display": { "kind": "tree" }
}
