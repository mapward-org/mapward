{
  "label": "Файлы",
  "refresh": "on-display",
  "collectors": [
    {
      "kind": "read-dir",
      "basePath": "${{ mapward://~#props.fullPath }}",
      "exclude": ["**/node_modules/**", "**/dist/**"],
      "watch": true
    }
  ],
  "transforms": [{ "kind": "git-status" }],
  "display": { "kind": "tree" }
}
