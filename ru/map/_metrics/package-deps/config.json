{
  "label": "Зависимости пакетов",
  "component": "${{ mapward:// }}/_plugins/views/list.tsx",
  "params": {
    "source": {
      "plugin": "${{ mapward:// }}/_plugins/shell",
      "method": "json",
      "params": {
        "command": "node \"${{ mapward:// }}/_metrics/package-deps/deps.mjs\" \"${{ mapward://@ }}\"",
        "env": {
          "MAPWARD_MAP_PATH": "${{ mapward:// }}"
        }
      }
    },
    "empty": "внутренних зависимостей нет"
  },
  "agent": {
    "plugin": "${{ mapward:// }}/_plugins/shell",
    "method": "json",
    "params": {
      "command": "node \"${{ mapward:// }}/_metrics/package-deps/deps.mjs\" \"${{ mapward://@ }}\"",
      "env": {
        "MAPWARD_MAP_PATH": "${{ mapward:// }}"
      }
    }
  }
}
