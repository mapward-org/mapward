{
  "label": "Битые адреса требований",
  "refresh": "on-display",
  "collectors": [
    { "kind": "read-dir", "basePath": "${{ mapward://@ }}/ru/requirements", "include": ["**/*.md"], "content": true }
  ],
  "transforms": [
    { "kind": "script", "run": "node \"${{ mapward://prototypes/system }}/_metrics/requirements/links.mjs\"" }
  , { "kind": "git-status" }],
  "display": { "kind": "list", "empty": "все адреса на месте" }
}
