{
  "name": "abstract-server",
  "extends": "mapward://prototypes/package",
  "props": {
    "codePath": "packages/abstract-server",
    "docsPath": "ru/docs/architecture/packages.md",
    "packageName": "@mapward/abstract-server",
    "architectureDoc": "ru/docs/architecture/abstract-server.md"
  },
  "preview-size": {
    "w": 2,
    "h": 1
  },
  "preview-metrics-layout": {
    "areas": [["code"]]
  },
  "details-metrics-layout": {
    "min-width: 0px": {
      "areas": [
        ["code"],
        ["docs"],
        ["version"],
        ["tests"],
        ["lint"],
        ["public-api"],
        ["architecture"],
        ["requirements-todo"],
        ["architecture-drift"],
        ["code-drift"],
        ["decisions"],
        ["requirements"],
        ["files"]
      ],
      "style": {
        "gap": "8px"
      }
    },
    "min-width: 600px": {
      "areas": [
        ["code", "docs"],
        ["version", "tests"],
        ["lint", "public-api"],
        ["architecture", "architecture"],
        ["requirements-todo", "requirements-todo"],
        ["architecture-drift", "architecture-drift"],
        ["code-drift", "code-drift"],
        ["decisions", "decisions"],
        ["requirements", "requirements"],
        ["files", "files"]
      ],
      "style": {
        "gap": "8px"
      }
    }
  }
}
