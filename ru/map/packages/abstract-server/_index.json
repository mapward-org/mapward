{
  "name": "abstract-server",
  "extends": "mapward://prototypes/package",
  "props": {
    "codePath": "packages/abstract-server",
    "docsPath": "ru/docs/mapward/architecture.md",
    "packageName": "@mapward/abstract-server"
  },
  "preview-size": { "w": 2, "h": 1 },
  "preview-metrics-layout": {
    "areas": [["code"]]
  },
  "details-metrics-layout": {
    "areas": [
      ["code", "docs"],
      ["requirements-todo", "requirements-todo"],
      ["code-drift", "code-drift"],
      ["requirements", "requirements"],
      ["files", "files"]
    ],
    "style": { "gridTemplateRows": "auto auto auto auto 1fr", "gap": "8px" }
  }
}
