{
  "name": "abstract-server",
  "extends": "mapward://prototypes/package",
  "props": {
    "codePath": "packages/abstract-server",
    "docsPath": "ru/docs/architecture/packages.md",
    "packageName": "@mapward/abstract-server",
    "architectureDoc": "ru/docs/architecture/abstract-server.md"
  },
  "metric-groups": {
    "groups": [
      {
        "key": "всё",
        "label": "Всё",
        "metrics": [
          "code",
          "docs",
          "version",
          "tests",
          "lint",
          "public-api",
          "architecture",
          "requirements-todo",
          "architecture-drift",
          "code-drift",
          "decisions",
          "requirements",
          "files"
        ],
        "layout": "./layout.tsx"
      },
      {
        "key": "превью",
        "label": "Карточка",
        "description": "Что видно на карточке объекта там, где он встречается на чужом экране.",
        "metrics": ["code"],
        "defaultPreview": true
      }
    ]
