{
  "name": "Расширение VS Code",
  "extends": "mapward://prototypes/system",
  "props": {
    "codePath": "apps/vscode-extension",
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}",
    "architectureDoc": "ru/docs/architecture/vscode-extension.md"
  },
  "metric-groups": {
    "groups": [
      {
        "key": "продукт",
        "label": "Работа с продуктом",
        "description": "Что делаем и почему: требования на этом объекте и решения.",
        "metrics": ["requirements-todo", "requirements", "decisions", "howto"],
        "details-metrics-layout": {
          "areas": [["requirements-todo"], ["requirements"], ["decisions"], ["howto"]],
          "style": {
            "gap": "8px"
          }
        }
      },
      {
        "key": "архитектура",
        "label": "Архитектура",
        "description": "Как устроено расширение: доки, расхождения с ними и файлы.",
        "metrics": ["code", "architecture", "architecture-drift", "code-drift", "files"],
        "details-metrics-layout": {
          "min-width: 0px": {
            "areas": [
              ["code"],
              ["architecture"],
              ["architecture-drift"],
              ["code-drift"],
              ["files"]
            ],
            "style": {
              "gap": "8px"
            }
          },
          "min-width: 600px": {
            "areas": [
              ["code", "architecture"],
              ["architecture-drift", "architecture-drift"],
              ["code-drift", "code-drift"],
              ["files", "files"]
            ],
            "style": {
              "gap": "8px"
            }
          }
        }
      },
      {
        "key": "публикация",
        "label": "Публикация",
        "description": "Локальный выпуск: что собрано и что стоит в редакторе. Кнопка «Собрать и поставить» — на корне карты, во вкладке «Быстрый доступ». Витрины пока нет.",
        "metrics": ["release-version", "release-vsix"],
        "details-metrics-layout": {
          "areas": [["release-version"], ["release-vsix"]],
          "style": {
            "gap": "8px"
          }
        }
      },
      {
        "key": "превью",
        "label": "Карточка",
        "description": "Что видно на карточке объекта там, где он встречается на чужом экране.",
        "metrics": ["code"],
        "defaultPreview": true,
        "details-metrics-layout": {
          "areas": [["code"]],
          "style": {
            "gap": "8px"
          }
        }
      }
    ]
  }
}
