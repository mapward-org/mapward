{
  "name": "Расширение VS Code",
  "extends": "mapward://prototypes/system",
  "props": {
    "codePath": "apps/vscode-extension",
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}",
    "architectureDoc": "ru/docs/architecture/vscode-extension.md"
  },
  "preview-metrics-layout": {
    "areas": [
      [
        "code"
      ]
    ]
  },
  "details-metrics-layout": {
    "areas": [
      [
        "code",
        "architecture"
      ],
      [
        "requirements-todo",
        "requirements-todo"
      ],
      [
        "architecture-drift",
        "architecture-drift"
      ],
      [
        "code-drift",
        "code-drift"
      ],
      [
        "decisions",
        "decisions"
      ],
      [
        "requirements",
        "requirements"
      ],
      [
        "files",
        "files"
      ]
    ],
    "style": {
      "gridTemplateRows": "auto auto auto auto auto auto 1fr",
      "gap": "8px"
    }
  }
}
