{
  "name": "Расширение VS Code",
  "extends": "mapward://prototypes/system",
  "props": {
    "codePath": "apps/vscode-extension",
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}"
  },
  "preview-metrics-layout": {
    "areas": [["code"]]
  },
  "details-metrics-layout": {
    "areas": [
      ["code", "architecture"],
      ["requirements-todo", "requirements-todo"],
      ["code-drift", "code-drift"],
      ["requirements", "requirements"],
      ["files", "files"]
    ],
    "style": { "gridTemplateRows": "auto auto auto auto 1fr", "gap": "8px" }
  }
}
