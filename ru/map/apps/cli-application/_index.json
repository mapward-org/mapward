{
  "name": "CLI",
  "extends": "mapward://prototypes/system",
  "props": {
    "codePath": "apps/cli",
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}",
    "architectureDoc": "ru/docs/architecture/cli.md"
  },
  "metric-groups": {
    "groups": [
      {
        "key": "всё",
        "label": "Всё",
        "metrics": [
          "code",
          "docs",
          "architecture",
          "requirements-todo",
          "architecture-drift",
          "code-drift",
          "decisions",
          "requirements",
          "files"
        ],
        "layout": "./layout.tsx"
      },
      {
        "key": "превью",
        "label": "Карточка",
        "description": "Что видно на карточке объекта там, где он встречается на чужом экране.",
        "metrics": ["code"],
        "defaultPreview": true
      }
    ]
  }
}
