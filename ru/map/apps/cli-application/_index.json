{
  "name": "CLI",
  "extends": "mapward://prototypes/system",
  "props": {
    "codePath": "apps/cli",
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}",
    "architectureDoc": "ru/docs/architecture/cli.md"
  },
  "details-metrics-layout": {
    "min-width: 0px": {
      "areas": [
        ["code"],
        ["docs"],
        ["architecture"],
        ["requirements-todo"],
        ["architecture-drift"],
        ["code-drift"],
        ["decisions"],
        ["requirements"],
        ["files"]
      ],
      "style": {
        "gap": "8px"
      }
    },
    "min-width: 600px": {
      "areas": [
        ["code", "docs"],
        ["architecture", "architecture"],
        ["requirements-todo", "requirements-todo"],
        ["architecture-drift", "architecture-drift"],
        ["code-drift", "code-drift"],
        ["decisions", "decisions"],
        ["requirements", "requirements"],
        ["files", "files"]
      ],
      "style": {
        "gap": "8px"
      }
    }
  },
  "metric-groups": {
    "groups": [
      {
        "key": "всё",
        "label": "Всё",
        "metrics": [
          "code",
          "docs",
          "architecture",
          "requirements-todo",
          "architecture-drift",
          "code-drift",
          "decisions",
          "requirements",
          "files"
        ]
      },
      {
        "key": "превью",
        "label": "Карточка",
        "description": "Что видно на карточке объекта там, где он встречается на чужом экране.",
        "metrics": ["code"],
        "defaultPreview": true,
        "details-metrics-layout": {
          "areas": [["code"]],
          "style": {
            "gap": "8px"
          }
        }
      }
    ]
  }
}
