{
  "name": "Пакет",
  "extends": "mapward://prototypes/system",
  "props": {
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}"
  },
  "preview-size": { "w": 2, "h": 1 },
  "preview-metrics-layout": {
    "areas": [["code", "tests"]]
  },
  "details-metrics-layout": {
    "areas": [
      ["code", "docs", "version"],
      ["tests", "lint", "public-api"],
      ["requirements-todo", "requirements-todo", "requirements-todo"],
      ["requirements-drift", "requirements-drift", "requirements-drift"],
      ["requirements", "requirements", "requirements"],
      ["files", "files", "files"]
    ],
    "style": { "gridTemplateRows": "auto auto auto auto auto 1fr", "gap": "8px" }
  }
}
