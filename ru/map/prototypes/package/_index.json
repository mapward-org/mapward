{
  "name": "Пакет",
  "extends": "mapward://prototypes/system",
  "props": {
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}"
  },
  "preview-size": {
    "w": 2,
    "h": 1
  },
  "preview-metrics-layout": {
    "areas": [
      [
        "code",
        "tests"
      ]
    ]
  },
  "details-metrics-layout": {
    "areas": [
      [
        "code",
        "docs",
        "version"
      ],
      [
        "tests",
        "lint",
        "public-api"
      ],
      [
        "architecture",
        "architecture",
        "architecture"
      ],
      [
        "requirements-todo",
        "requirements-todo",
        "requirements-todo"
      ],
      [
        "architecture-drift",
        "architecture-drift",
        "architecture-drift"
      ],
      [
        "code-drift",
        "code-drift",
        "code-drift"
      ],
      [
        "decisions",
        "decisions",
        "decisions"
      ],
      [
        "requirements",
        "requirements",
        "requirements"
      ],
      [
        "files",
        "files",
        "files"
      ]
    ],
    "style": {
      "gridTemplateRows": "max-content max-content max-content fit-content(300px) fit-content(200px) fit-content(200px) fit-content(300px) fit-content(300px) fit-content(300px)",
      "gap": "8px"
    }
  }
}
