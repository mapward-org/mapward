{
  "name": "Пакет",
  "extends": "mapward://prototypes/system",
  "props": {
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}"
  },
  "details-metrics-layout": {
    "min-width: 0px": {
      "areas": [
        ["code"],
        ["docs"],
        ["version"],
        ["tests"],
        ["lint"],
        ["public-api"],
        ["architecture"],
        ["requirements-todo"],
        ["architecture-drift"],
        ["code-drift"],
        ["decisions"],
        ["requirements"],
        ["howto"],
        ["files"]
      ],
      "style": {
        "gap": "8px"
      }
    },
    "min-width: 600px": {
      "areas": [
        ["code", "docs", "version"],
        ["tests", "lint", "public-api"],
        ["architecture", "architecture", "architecture"],
        ["requirements-todo", "requirements-todo", "requirements-todo"],
        ["architecture-drift", "architecture-drift", "architecture-drift"],
        ["code-drift", "code-drift", "code-drift"],
        ["decisions", "decisions", "decisions"],
        ["requirements", "requirements", "requirements"],
        ["howto", "howto", "howto"],
        ["files", "files", "files"]
      ],
      "style": {
        "gap": "8px"
      }
    }
  },
  "metric-groups": {
    "groups": [
      {
        "key": "всё",
        "label": "Всё",
        "metrics": [
          "code",
          "docs",
          "version",
          "tests",
          "lint",
          "public-api",
          "architecture",
          "requirements-todo",
          "architecture-drift",
          "code-drift",
          "decisions",
          "requirements",
          "howto",
          "files"
        ]
      },
      {
        "key": "превью",
        "label": "Карточка",
        "description": "Что видно на карточке объекта там, где он встречается на чужом экране.",
        "metrics": ["code", "tests"],
        "defaultPreview": true,
        "details-metrics-layout": {
          "areas": [["code"], ["tests"]],
          "style": {
            "gap": "8px"
          }
        }
      }
    ]
  }
}
