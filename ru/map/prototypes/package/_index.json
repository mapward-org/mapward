{
  "name": "Пакет",
  "extends": "mapward://prototypes/system",
  "props": {
    "fullPath": "${{ mapward://@ }}/${{ mapward://~#props.codePath }}"
  },
  "metric-groups": {
    "groups": [
      {
        "key": "всё",
        "label": "Всё",
        "metrics": [
          "code",
          "version",
          "tests",
          "lint",
          "public-api",
          "architecture",
          "requirements-todo",
          "architecture-drift",
          "code-drift",
          "decisions",
          "requirements",
          "howto",
          "files",
          "files-live"
        ],
        "layout": "./layout.tsx"
      },
      {
        "key": "превью",
        "label": "Карточка",
        "description": "Что видно на карточке объекта там, где он встречается на чужом экране.",
        "metrics": ["code", "tests"],
        "defaultPreview": true
      }
    ]
  }
}
