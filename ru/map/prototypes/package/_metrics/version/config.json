{
  "label": "Версия",
  "component": "${{ mapward:// }}/_plugins/views/text.tsx",
  "params": {
    "source": {
      "plugin": "${{ mapward:// }}/_plugins/shell",
      "method": "json",
      "params": {
        "command": "node -e \"console.log(JSON.stringify({text:require('./package.json').version}))\"",
        "cwd": "${{ mapward://~#props.fullPath }}",
        "watch": {
          "include": ["${{ mapward://~#props.fullPath }}/package.json"]
        }
      }
    }
  },
  "agent": {
    "plugin": "${{ mapward:// }}/_plugins/shell",
    "method": "json",
    "params": {
      "command": "node -e \"console.log(JSON.stringify({text:require('./package.json').version}))\"",
      "cwd": "${{ mapward://~#props.fullPath }}",
      "watch": {
        "include": ["${{ mapward://~#props.fullPath }}/package.json"]
      }
    }
  }
}
