{
  "label": "Новая папка",
  "description": "Создать папку. В имени можно написать вложенный путь — недостающие папки создадутся.",
  "inputs": {
    "folder": {
      "type": "string",
      "required": true,
      "default": "${{ mapward://~#props.fullPath }}",
      "description": "в какой папке"
    },
    "name": { "type": "string", "required": true, "description": "имя папки, можно lib/parts" }
  },
  "runners": [
    {
      "kind": "script",
      "name": "создать папку",
      "run": "node \"${{ mapward:// }}/shared-metrics/files/file-ops.mjs\" new-folder \"${{ mapward://~#props.fullPath }}\""
    }
  ]
}
