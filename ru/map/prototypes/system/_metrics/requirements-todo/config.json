{
  "label": "Требования для реализации",
  "refresh": "on-display",
  "collectors": [
    {
      "kind": "read-dir",
      "basePath": "${{ mapward://~#props.requirementsPath }}",
      "include": ["**/*.md"],
      "content": true
    }
  ],
  "transforms": [{ "kind": "script", "run": "node \"${{ mapward://prototypes/system }}/_metrics/requirements/status.mjs\" --own --todo" }],
  "display": { "kind": "tree", "empty": "всё сделано" }
}
