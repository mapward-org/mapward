{
  "label": "Требования для реализации",
  "component": "${{ mapward:// }}/_plugins/views/tree.tsx",
  "params": {
    "source": {
      "plugin": "${{ mapward:// }}/_plugins/shell",
      "method": "json",
      "params": {
        "command": "node \"${{ mapward://prototypes/system }}/_metrics/requirements/status.mjs\" --own --todo",
        "env": {
          "MAPWARD_MAP_PATH": "${{ mapward:// }}",
          "MAPWARD_OBJECT_PATH": "${{ mapward://~ }}"
        },
        "from": {
          "plugin": "${{ mapward:// }}/_plugins/files",
          "method": "tree",
          "params": {
            "path": "${{ mapward://~#props.requirementsPath }}",
            "include": ["**/*.md"],
            "content": true,
            "git": true
          }
        }
      }
    },
    "empty": "всё сделано"
  },
  "agent": {
    "plugin": "${{ mapward:// }}/_plugins/shell",
    "method": "json",
    "params": {
      "command": "node \"${{ mapward://prototypes/system }}/_metrics/requirements/status.mjs\" --own --todo",
      "env": {
        "MAPWARD_MAP_PATH": "${{ mapward:// }}",
        "MAPWARD_OBJECT_PATH": "${{ mapward://~ }}"
      },
      "from": {
        "plugin": "${{ mapward:// }}/_plugins/files",
        "method": "tree",
        "params": {
          "path": "${{ mapward://~#props.requirementsPath }}",
          "include": ["**/*.md"],
          "content": true,
          "git": true
        }
      }
    }
  }
}
