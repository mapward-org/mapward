node_modules/
dist/
*.tsbuildinfo
.DS_Store

# turborepo cache
.turbo/

# Слепок и .vsix локальной сборки расширения: артефакт установки, а не исходник
apps/vscode-extension/build/

# Метрики пишут логи прогона рядом с конфигом — это объяснение красной точки,
# а не часть карты
*.logs.json

# Локальные настройки агента: там разрешения конкретной машины, иногда с доступами
.claude/

# tsdown кладёт объявления рядом с исходниками при сборке пакета
packages/*/src/**/*.d.ts

# Доки инструмента собираются в модуль перед сборкой: markdown рядом — источник,
# а две копии одного текста в гите разъезжаются
packages/docs/src/content.generated.ts
