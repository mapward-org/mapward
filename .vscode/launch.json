{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Расширение",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension",
        "--disable-extension=mapward.mapward"
