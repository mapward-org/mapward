{
  "name": "@mapward/core",
  "version": "0.0.0",
  "private": true,
  "description": "The link between the sides: bridge contracts and protocol, the types that travel over them, addresses and the small helpers both sides compute alike. The server builds the map; this is what it hands over.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "rxjs": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:"
  }
}
