{
  "name": "@mapward/vfs",
  "version": "0.0.0",
  "private": true,
  "description": "Files as streams with point subscriptions: a file or a folder is read when someone subscribes and released when nobody does; one watcher per root, changes in batches. Environment comes through ports.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:"
  }
}
